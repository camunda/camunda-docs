<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrderProcessAgent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.36.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="order-process-agent" name="Order process with an AI agent" isExecutable="true">
    <bpmn:startEvent id="OrderPlaced" name="Order placed">
      <bpmn:outgoing>Flow_placed_collect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CollectMoney" name="Collect money">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="collect-money" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_placed_collect</bpmn:incoming>
      <bpmn:outgoing>Flow_collect_fetch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:adHocSubProcess id="FetchItems" name="Fetch items" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="11" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>Decides how to source the ordered items and completes when every item is accounted for.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="anthropic" target="provider.type" />
          <zeebe:input source="{{secrets.ANTHROPIC_API_KEY}}" target="provider.anthropic.authentication.apiKey" />
          <zeebe:input source="claude-sonnet-4-5" target="provider.anthropic.model.model" />
          <zeebe:input source="=&#34;You fulfill customer orders. Use the available tools to source every item on the order, and ask the warehouse team when the tools cannot resolve the situation.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Source the items for order &#34; + orderId" target="data.userPrompt.prompt" />
          <zeebe:input target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=false" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="11" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_collect_fetch</bpmn:incoming>
      <bpmn:outgoing>Flow_fetch_ship</bpmn:outgoing>
      <bpmn:serviceTask id="CheckInventory" name="Check inventory">
        <bpmn:documentation>Look up the stock level for an item in the warehouse. Returns the quantity currently on hand. Call this before reserving stock.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="check-inventory" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.itemId, &#34;The ID of the item to check&#34;, &#34;string&#34;)" target="itemId" />
            <zeebe:output source="=stockLevel" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ReserveStock" name="Reserve stock">
        <bpmn:documentation>Reserve a quantity of an item that is already in the warehouse. Returns the reservation ID. Do not call for items that are out of stock.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reserve-stock" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.itemId, &#34;The ID of the item to reserve&#34;, &#34;string&#34;)" target="itemId" />
            <zeebe:input source="=fromAi(toolCall.quantity, &#34;How many units to reserve&#34;, &#34;number&#34;)" target="quantity" />
            <zeebe:output source="=reservationId" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="OrderFromSupplier" name="Order from supplier">
        <bpmn:documentation>Place a backorder with the supplier for an item that is out of stock. Returns the expected delivery date. Use only when inventory cannot cover the order.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="order-from-supplier" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.itemId, &#34;The ID of the item to backorder&#34;, &#34;string&#34;)" target="itemId" />
            <zeebe:input source="=fromAi(toolCall.quantity, &#34;How many units to backorder&#34;, &#34;number&#34;)" target="quantity" />
            <zeebe:output source="=expectedDelivery" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:userTask id="AskWarehouseTeam" name="Ask warehouse team">
        <bpmn:documentation>Ask a member of the warehouse team to decide how to handle the order. Returns their answer. Use when the other tools cannot resolve the situation.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="warehouse-question" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.question, &#34;The question to ask the warehouse team&#34;, &#34;string&#34;)" target="question" />
            <zeebe:output source="=answer" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:userTask>
    </bpmn:adHocSubProcess>
    <bpmn:serviceTask id="ShipParcel" name="Ship parcel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ship-parcel" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_fetch_ship</bpmn:incoming>
      <bpmn:outgoing>Flow_ship_delivered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OrderDelivered" name="Order delivered">
      <bpmn:incoming>Flow_ship_delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_placed_collect" sourceRef="OrderPlaced" targetRef="CollectMoney" />
    <bpmn:sequenceFlow id="Flow_collect_fetch" sourceRef="CollectMoney" targetRef="FetchItems" />
    <bpmn:sequenceFlow id="Flow_fetch_ship" sourceRef="FetchItems" targetRef="ShipParcel" />
    <bpmn:sequenceFlow id="Flow_ship_delivered" sourceRef="ShipParcel" targetRef="OrderDelivered" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order-process-agent">
      <bpmndi:BPMNShape id="OrderPlaced_di" bpmnElement="OrderPlaced">
        <dc:Bounds x="160" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="147" y="275" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CollectMoney_di" bpmnElement="CollectMoney">
        <dc:Bounds x="250" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FetchItems_di" bpmnElement="FetchItems" isExpanded="true">
        <dc:Bounds x="410" y="120" width="320" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckInventory_di" bpmnElement="CheckInventory">
        <dc:Bounds x="450" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReserveStock_di" bpmnElement="ReserveStock">
        <dc:Bounds x="590" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderFromSupplier_di" bpmnElement="OrderFromSupplier">
        <dc:Bounds x="450" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AskWarehouseTeam_di" bpmnElement="AskWarehouseTeam">
        <dc:Bounds x="590" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShipParcel_di" bpmnElement="ShipParcel">
        <dc:Bounds x="790" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderDelivered_di" bpmnElement="OrderDelivered">
        <dc:Bounds x="940" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="922" y="275" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_placed_collect_di" bpmnElement="Flow_placed_collect">
        <di:waypoint x="196" y="250" />
        <di:waypoint x="250" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_collect_fetch_di" bpmnElement="Flow_collect_fetch">
        <di:waypoint x="350" y="250" />
        <di:waypoint x="410" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_fetch_ship_di" bpmnElement="Flow_fetch_ship">
        <di:waypoint x="730" y="250" />
        <di:waypoint x="790" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ship_delivered_di" bpmnElement="Flow_ship_delivered">
        <di:waypoint x="890" y="250" />
        <di:waypoint x="940" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
