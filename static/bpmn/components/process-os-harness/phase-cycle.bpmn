<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1xm9sbj" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_14wo4pv">
    <bpmn:participant id="Participant_0ms1fke" name="Use ProcessOS" processRef="process-os-governance" />
    <bpmn:group id="Group_1ayl1zi" categoryValueRef="CategoryValue_0mlffh2" />
  </bpmn:collaboration>
  <bpmn:process id="process-os-governance" name="ProcessOS Project Governance" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1wmymta">
      <bpmn:lane id="Lane_0obwund" name="Driven by Builder">
        <bpmn:flowNodeRef>Gateway_NextDiscoveryIteration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ExecuteDiscovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DiscoveryIterationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfigureDiscovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_AsIsModelsFinalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DefineNextDiscoveryIteration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_12f89g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_18ogl4e" name="SME">
        <bpmn:flowNodeRef>SubProcess_ReviewAsIsResults</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_NextDiscoveryIteration" name="Next iteration?" default="SequenceFlow_AnotherDiscoveryIteration">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_031y0wx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnotherDiscoveryIteration</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AsIsApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_ExecuteDiscovery" name="Builder task" zeebe:modelerTemplate="io.camunda.process-os.governance-job" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;utf8,&#60;svg xmlns=&#39;http://www.w3.org/2000/svg&#39; viewBox=&#39;0 0 24 24&#39;&#62;&#60;rect width=&#39;24&#39; height=&#39;24&#39; rx=&#39;5&#39; fill=&#39;%23FC5D0D&#39;/&#62;&#60;text x=&#39;12&#39; y=&#39;15.2&#39; font-family=&#39;Helvetica,Arial,sans-serif&#39; font-size=&#39;12.5&#39; font-weight=&#39;700&#39; fill=&#39;%23fff&#39; text-anchor=&#39;middle&#39; letter-spacing=&#39;0.2&#39;&#62;OS&#60;/text&#62;&#60;path d=&#39;M6.5 19.8h11&#39; stroke=&#39;%23fff&#39; stroke-width=&#39;1.7&#39; stroke-linecap=&#39;round&#39;/&#62;&#60;g fill=&#39;%23fff&#39;&#62;&#60;circle cx=&#39;6.5&#39; cy=&#39;19.8&#39; r=&#39;1.9&#39;/&#62;&#60;circle cx=&#39;17.5&#39; cy=&#39;19.8&#39; r=&#39;1.9&#39;/&#62;&#60;/g&#62;&#60;/svg&#62;">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="= projectName + &#34;_process-os-job&#34;" />
        <zeebe:taskHeaders>
          <zeebe:header key="skillName" value="process-os-process-discovery" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= {&#10;  &#34;dataSources&#34;: flatten(for s in [&#34;filesystem&#34;,&#34;web&#34;,&#34;enterprise&#34;,&#34;github&#34;] return if get value(discoverySettings.specialists, s).enabled = true then (for r in get or else(get value(discoverySettings.specialists, s).sources, []) return {url: r.url, type: s})[item.url != null and item.url != &#34;&#34;] else [])&#10;}" target="skillInput" />
          <zeebe:input source="= {&#10;  &#34;runConfigVersion&#34;: 2,&#10;  &#34;mode&#34;: &#34;interactive&#34;,&#10;  &#34;max-research-rounds&#34;: get or else(expertSettings.maxResearchRounds, 5),&#10;  &#34;decomposition&#34;: get or else(expertSettings.decomposition, &#34;single&#34;),&#10;  &#34;edge-cases&#34;: get or else(expertSettings.edgeCases, &#34;skip&#34;),&#10;  &#34;skip-provenance&#34;: get or else(expertSettings.skipProvenance, false),&#10;  &#34;skip-review&#34;: get or else(expertSettings.skipReview, false),&#10;  &#34;skip-bpmn-docs&#34;: get or else(expertSettings.skipBpmnDocs, false),&#10;  &#34;compact-specialists&#34;: get or else(expertSettings.compactSpecialists, false),&#10;  &#34;plugin-model-high&#34;: if trim(get or else(expertSettings.pluginModelHigh, &#34;&#34;)) = &#34;&#34; then &#34;session&#34; else trim(expertSettings.pluginModelHigh),&#10;  &#34;plugin-model-medium&#34;: if trim(get or else(expertSettings.pluginModelMedium, &#34;&#34;)) = &#34;&#34; then &#34;session&#34; else trim(expertSettings.pluginModelMedium),&#10;  &#34;plugin-model-low&#34;: if trim(get or else(expertSettings.pluginModelLow, &#34;&#34;)) = &#34;&#34; then &#34;session&#34; else trim(expertSettings.pluginModelLow),&#10;  &#34;source-mode&#34;: get or else(discoverySettings.sourceMode, &#34;hint&#34;),&#10;  &#34;skip-system-context&#34;: get or else(expertSettings.skipSystemContext, false),&#10;  &#34;skip-as-is-bpmn&#34;: get or else(expertSettings.skipAsIsBpmn, false),&#10;  &#34;specialistsBuiltin&#34;: if count([&#34;filesystem&#34;,&#34;web&#34;,&#34;enterprise&#34;,&#34;github&#34;][get value(discoverySettings.specialists, item).enabled = true]) + count((for r in get or else(discoverySettings.specialistsExtra, []) return r.value)[item != null and item != &#34;&#34;]) = 0 then [&#34;filesystem&#34;] else [&#34;filesystem&#34;,&#34;web&#34;,&#34;enterprise&#34;,&#34;github&#34;][get value(discoverySettings.specialists, item).enabled = true],&#10;  &#34;specialistsExtra&#34;: (for r in get or else(discoverySettings.specialistsExtra, []) return r.value)[item != null and item != &#34;&#34;],&#10;  &#34;size&#34;: if get or else(expertSettings.bpmn.sizing, &#34;size&#34;) = &#34;widthDepth&#34; then &#34;auto&#34; else get or else(expertSettings.bpmn.size, &#34;auto&#34;),&#10;  &#34;width&#34;: if get or else(expertSettings.bpmn.sizing, &#34;size&#34;) = &#34;widthDepth&#34; then get or else(expertSettings.bpmn.width, &#34;auto&#34;) else &#34;auto&#34;,&#10;  &#34;depth&#34;: if get or else(expertSettings.bpmn.sizing, &#34;size&#34;) = &#34;widthDepth&#34; then get or else(expertSettings.bpmn.depth, &#34;auto&#34;) else &#34;auto&#34;&#10;}" target="runConfig" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_0bkcsj7</bpmn:incoming>
      <bpmn:outgoing>Flow_0th4h08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DiscoveryIterationMerge">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:incoming>SequenceFlow_AnotherDiscoveryIteration</bpmn:incoming>
      <bpmn:incoming>Flow_15th27w</bpmn:incoming>
      <bpmn:outgoing>Flow_0bkcsj7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ConfigureDiscovery" name="Configure iteration">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="configure-discovery" />
        <zeebe:ioMapping>
          <zeebe:input source="= discoveryIteration" target="iteration" />
          <zeebe:input source="= discoveryFeedbackDigest" target="feedbackDigest" />
          <zeebe:input source="= discoverySettings" target="discoverySettings" />
          <zeebe:input source="= discoverySettings" target="priorSettings" />
          <zeebe:input source="= expertSettings" target="expertSettings" />
          <zeebe:input source="= expertSettings" target="priorExpertSettings" />
          <zeebe:output source="= context merge([get or else(priorSettings, {}), get or else(discoverySettings, {})])" target="discoverySettings" />
          <zeebe:output source="= context merge([get or else(priorExpertSettings, {}), get or else(expertSettings, {})])" target="expertSettings" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1w5ncby</bpmn:incoming>
      <bpmn:outgoing>Flow_15th27w</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_AsIsModelsFinalized" name="Phase finalized">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=1" target="transformationIteration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:incoming>SequenceFlow_AsIsApproved</bpmn:incoming>
    </bpmn:intermediateThrowEvent>
    <bpmn:subProcess id="SubProcess_ReviewAsIsResults" name="Review results">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=discoveryIteration + 1" target="discoveryIteration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_0th4h08</bpmn:incoming>
      <bpmn:outgoing>Flow_1398lus</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_AsIsReviewStarted" name="Review started">
        <bpmn:outgoing>Flow_0n7vhng</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask_GetDiscoveryQuestionsAsForm" name="Get discovery questions as form" zeebe:modelerTemplate="io.camunda.process-os.governance-job" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;utf8,&#60;svg xmlns=&#39;http://www.w3.org/2000/svg&#39; viewBox=&#39;0 0 24 24&#39;&#62;&#60;rect width=&#39;24&#39; height=&#39;24&#39; rx=&#39;5&#39; fill=&#39;%23FC5D0D&#39;/&#62;&#60;text x=&#39;12&#39; y=&#39;15.2&#39; font-family=&#39;Helvetica,Arial,sans-serif&#39; font-size=&#39;12.5&#39; font-weight=&#39;700&#39; fill=&#39;%23fff&#39; text-anchor=&#39;middle&#39; letter-spacing=&#39;0.2&#39;&#62;OS&#60;/text&#62;&#60;path d=&#39;M6.5 19.8h11&#39; stroke=&#39;%23fff&#39; stroke-width=&#39;1.7&#39; stroke-linecap=&#39;round&#39;/&#62;&#60;g fill=&#39;%23fff&#39;&#62;&#60;circle cx=&#39;6.5&#39; cy=&#39;19.8&#39; r=&#39;1.9&#39;/&#62;&#60;circle cx=&#39;17.5&#39; cy=&#39;19.8&#39; r=&#39;1.9&#39;/&#62;&#60;/g&#62;&#60;/svg&#62;">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="= projectName + &#34;_process-os-job&#34;" />
          <zeebe:taskHeaders>
            <zeebe:header key="skillName" value="process-os-question-form-generation" />
          </zeebe:taskHeaders>
          <zeebe:ioMapping>
            <zeebe:input source="discovery" target="skillMode" />
            <zeebe:output source="= skillOutput" target="discoveryQuestions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1odwlvn</bpmn:incoming>
        <bpmn:outgoing>Flow_0jtzfor</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_AnyDiscoveryQuestions" name="Any discovery questions?" default="SequenceFlow_DiscoveryGapsToClarify">
        <bpmn:incoming>Flow_0jtzfor</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_DiscoveryGapsToClarify</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_NoDiscoveryGaps</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask_ReplyToDiscoveryQuestions" name="Reply to discovery questions">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="gaps-discovery" />
          <zeebe:ioMapping>
            <zeebe:input source="= discoveryQuestions" target="questions" />
            <zeebe:output source="= questions" target="discoveryQuestions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>SequenceFlow_DiscoveryGapsToClarify</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_DiscoveryQuestionsAnswered</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_DiscoveryQuestionsMerge">
        <bpmn:incoming>SequenceFlow_NoDiscoveryGaps</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_DiscoveryQuestionsAnswered</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_DiscoveryGapsResolved</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_AsIsReviewCompleted" name="Review completed">
        <bpmn:incoming>Flow_1ko7t82</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="UserTask_ReviewAsIsAssets" name="Review as-is assets">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="review-discovery" />
          <zeebe:ioMapping>
            <zeebe:output source="= assetFeedback" target="discoveryAssetFeedback" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0yyui59</bpmn:incoming>
        <bpmn:outgoing>Flow_1ymj2fk</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="Gateway_AsIsReviewFork">
        <bpmn:incoming>Flow_0n7vhng</bpmn:incoming>
        <bpmn:outgoing>Flow_0yyui59</bpmn:outgoing>
        <bpmn:outgoing>Flow_1odwlvn</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:parallelGateway id="Gateway_AsIsReviewJoin">
        <bpmn:incoming>Flow_1ymj2fk</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_DiscoveryGapsResolved</bpmn:incoming>
        <bpmn:outgoing>Flow_1h52nca</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask_ConsolidateAsIsFeedback" name="Consolidate feedback from all channels" zeebe:modelerTemplate="io.camunda.process-os.governance-job" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;utf8,&#60;svg xmlns=&#39;http://www.w3.org/2000/svg&#39; viewBox=&#39;0 0 24 24&#39;&#62;&#60;rect width=&#39;24&#39; height=&#39;24&#39; rx=&#39;5&#39; fill=&#39;%23FC5D0D&#39;/&#62;&#60;text x=&#39;12&#39; y=&#39;15.2&#39; font-family=&#39;Helvetica,Arial,sans-serif&#39; font-size=&#39;12.5&#39; font-weight=&#39;700&#39; fill=&#39;%23fff&#39; text-anchor=&#39;middle&#39; letter-spacing=&#39;0.2&#39;&#62;OS&#60;/text&#62;&#60;path d=&#39;M6.5 19.8h11&#39; stroke=&#39;%23fff&#39; stroke-width=&#39;1.7&#39; stroke-linecap=&#39;round&#39;/&#62;&#60;g fill=&#39;%23fff&#39;&#62;&#60;circle cx=&#39;6.5&#39; cy=&#39;19.8&#39; r=&#39;1.9&#39;/&#62;&#60;circle cx=&#39;17.5&#39; cy=&#39;19.8&#39; r=&#39;1.9&#39;/&#62;&#60;/g&#62;&#60;/svg&#62;">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="= projectName + &#34;_process-os-job&#34;" />
          <zeebe:taskHeaders>
            <zeebe:header key="skillName" value="process-os-sme-feedback" />
          </zeebe:taskHeaders>
          <zeebe:ioMapping>
            <zeebe:input source="discovery" target="skillMode" />
            <zeebe:input source="= {&#10;  &#34;discoveryQuestions&#34;: discoveryQuestions,&#10;  &#34;discoveryAssetFeedback&#34;: discoveryAssetFeedback&#10;}" target="skillInput" />
            <zeebe:input source="= {&#10;  &#34;runConfigVersion&#34;: 2,&#10;  &#34;mode&#34;: &#34;interactive&#34;&#10;}" target="runConfig" />
            <zeebe:output source="= skillOutput" target="discoveryFeedbackDigest" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1h52nca</bpmn:incoming>
        <bpmn:outgoing>Flow_1ko7t82</bpmn:outgoing>
        <bpmn:property id="Property_1bwfxoh" name="__targetRef_placeholder" />
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0n7vhng" sourceRef="StartEvent_AsIsReviewStarted" targetRef="Gateway_AsIsReviewFork" />
      <bpmn:sequenceFlow id="Flow_0jtzfor" sourceRef="ServiceTask_GetDiscoveryQuestionsAsForm" targetRef="Gateway_AnyDiscoveryQuestions" />
      <bpmn:sequenceFlow id="SequenceFlow_DiscoveryGapsToClarify" name="Questions open" sourceRef="Gateway_AnyDiscoveryQuestions" targetRef="UserTask_ReplyToDiscoveryQuestions" />
      <bpmn:sequenceFlow id="SequenceFlow_NoDiscoveryGaps" name="No questions" sourceRef="Gateway_AnyDiscoveryQuestions" targetRef="Gateway_DiscoveryQuestionsMerge">
        <bpmn:conditionExpression>= count(get or else(discoveryQuestions, [])) = 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SequenceFlow_DiscoveryQuestionsAnswered" sourceRef="UserTask_ReplyToDiscoveryQuestions" targetRef="Gateway_DiscoveryQuestionsMerge" />
      <bpmn:sequenceFlow id="SequenceFlow_DiscoveryGapsResolved" sourceRef="Gateway_DiscoveryQuestionsMerge" targetRef="Gateway_AsIsReviewJoin" />
      <bpmn:sequenceFlow id="Flow_1ko7t82" sourceRef="ServiceTask_ConsolidateAsIsFeedback" targetRef="EndEvent_AsIsReviewCompleted" />
      <bpmn:sequenceFlow id="Flow_0yyui59" sourceRef="Gateway_AsIsReviewFork" targetRef="UserTask_ReviewAsIsAssets" />
      <bpmn:sequenceFlow id="Flow_1ymj2fk" sourceRef="UserTask_ReviewAsIsAssets" targetRef="Gateway_AsIsReviewJoin" />
      <bpmn:sequenceFlow id="Flow_1h52nca" sourceRef="Gateway_AsIsReviewJoin" targetRef="ServiceTask_ConsolidateAsIsFeedback" />
      <bpmn:sequenceFlow id="Flow_1odwlvn" sourceRef="Gateway_AsIsReviewFork" targetRef="ServiceTask_GetDiscoveryQuestionsAsForm" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask_DefineNextDiscoveryIteration" name="Define next iteration">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="configure-discovery" />
        <zeebe:ioMapping>
          <zeebe:input source="= discoveryIteration" target="iteration" />
          <zeebe:input source="= discoveryFeedbackDigest" target="feedbackDigest" />
          <zeebe:input source="= discoverySettings" target="discoverySettings" />
          <zeebe:input source="= discoverySettings" target="priorSettings" />
          <zeebe:input source="= expertSettings" target="expertSettings" />
          <zeebe:input source="= expertSettings" target="priorExpertSettings" />
          <zeebe:output source="= context merge([get or else(priorSettings, {}), get or else(discoverySettings, {})])" target="discoverySettings" />
          <zeebe:output source="= context merge([get or else(priorExpertSettings, {}), get or else(expertSettings, {})])" target="expertSettings" />
          <zeebe:output source="= get or else(nextPhase, &#34;another&#34;) = &#34;next&#34;" target="asIsApproved" />
          <zeebe:output source="= approvalNote" target="discoveryApprovalNote" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1398lus</bpmn:incoming>
      <bpmn:outgoing>Flow_031y0wx</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Event_12f89g4" name="Phase started">
      <bpmn:outgoing>Flow_1w5ncby</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_031y0wx" sourceRef="UserTask_DefineNextDiscoveryIteration" targetRef="Gateway_NextDiscoveryIteration">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_AnotherDiscoveryIteration" name="Yes" sourceRef="Gateway_NextDiscoveryIteration" targetRef="Gateway_DiscoveryIterationMerge">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_AsIsApproved" name="No" sourceRef="Gateway_NextDiscoveryIteration" targetRef="IntermediateThrowEvent_AsIsModelsFinalized">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
      <bpmn:conditionExpression>= asIsApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0bkcsj7" sourceRef="Gateway_DiscoveryIterationMerge" targetRef="ServiceTask_ExecuteDiscovery">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0th4h08" sourceRef="ServiceTask_ExecuteDiscovery" targetRef="SubProcess_ReviewAsIsResults">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15th27w" sourceRef="UserTask_ConfigureDiscovery" targetRef="Gateway_DiscoveryIterationMerge">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1w5ncby" sourceRef="Event_12f89g4" targetRef="UserTask_ConfigureDiscovery" />
    <bpmn:sequenceFlow id="Flow_1398lus" sourceRef="SubProcess_ReviewAsIsResults" targetRef="UserTask_DefineNextDiscoveryIteration">
      <bpmn:categoryValueRef>CategoryValue_0mlffh2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:category id="Category_0oqd090">
    <bpmn:categoryValue id="CategoryValue_0mlffh2" value="Phase" />
  </bpmn:category>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_14wo4pv">
      <bpmndi:BPMNShape id="Participant_0ms1fke_di" bpmnElement="Participant_0ms1fke" isHorizontal="true">
        <dc:Bounds x="153" y="110" width="1067" height="400" />
