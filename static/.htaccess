# Welcome to the redirect party!
#  ____  ____  ____  __  ____  ____  ___  ____    ____   __   ____  ____  _  _  _
# (  _ \(  __)(    \(  )(  _ \(  __)/ __)(_  _)  (  _ \ / _\ (  _ \(_  _)( \/ )/ \
#  )   / ) _)  ) D ( )(  )   / ) _)( (__   )(     ) __//    \ )   /  )(   )  / \_/
# (__\_)(____)(____/(__)(__\_)(____)\___) (__)   (__)  \_/\_/(__\_) (__) (__/  (_)
#
# Please read this guide before adding new redirects.
#
##################################################################################
#
# Redirects in this file are sorted in this order:
#  1. Universal rules that pertain to all content.
#     These redirects have no anticipated removal.
#  2. Broad version (or unversioned) redirects.
#     These redirects have no anticipated removal.
#  3. Specific content moves, in newest-to-oldest order of version in which they are introduced.
#     These redirects will be removed when their introduced version is no longer supported.
#
#  If you're adding a redirect for a specific page or section,
#   you likely want to do that in #3.
#  That means that you want to find the banner comment identifying that version,
#    and add your redirect below that comment.
#
# For help writing rules, see https://httpd.apache.org/docs/current/mod/mod_rewrite.html#rewriterule.
#
##################################################################################

##################################################################################
# 1. Universal rules
##################################################################################

# Redirect to https
RewriteEngine on
RewriteCond %{SERVER_PORT} !^443$
RewriteRule (.*) https://%{SERVER_NAME}/$1 [R=301,L]

# Disable directory listing and multi views
Options -Indexes -MultiViews

# Add yaml mime type
AddType text/vnd.yaml   yaml
# Add bpmn mime type
AddType text/xml        bpmn
# Add graphql scheme mime type
AddType text/plain      graphqls
# Add diff mime type
AddType text/plain      diff

# Content negotiation: serve .md when Accept: text/markdown is requested
# Only applies to /docs/ paths that are not already static assets or .md files
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteCond %{REQUEST_URI} ^/docs/
RewriteCond %{REQUEST_URI} !\.(md|js|css|png|jpg|svg|json|xml|yaml|bpmn|pdf)$
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.md -f [OR]
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}index.md -f
RewriteRule ^(docs/.+?)/?$ /$1.md [L]

# Ensure Vary: Accept header is set on docs pages for proper caching
SetEnvIf Request_URI "^/docs/" DOCS_PATH
Header append Vary Accept env=DOCS_PATH

# workaround for 404 with trailing slashes https://github.com/camunda-cloud/camunda-cloud-documentation/issues/403
RewriteRule ^(.*\.(yaml|bpmn|xml|png|jpeg|jpg|yml|pdf|svg|graphqls|diff))/$ /$1 [R=301,L]

## Redirect for case-sensitive llms.txt
RewriteRule ^LLMs\.txt$ /llms.txt [R=301,L]



##################################################################################
# 2. Rules for 8.7
##################################################################################

RewriteRule ^docs/reference/announcements-release-notes/850/(.*)$ /8.7/docs/reference/announcements-release-notes/overview/$1 [R=301,L]
RewriteRule ^docs/reference/announcements-release-notes/850/850-announcements/?$ /8.7/docs/reference/announcements-release-notes/overview/ [R=301,L]
RewriteRule ^docs/reference/announcements-release-notes/850/850-release-notes/?$ /8.7/docs/reference/announcements-release-notes/overview/ [R=301,L]
RewriteRule ^docs/reference/announcements-release-notes/860/(.*)$ /8.7/docs/reference/announcements-release-notes/overview/$1 [R=301,L]
RewriteRule ^docs/reference/announcements-release-notes/860/860-announcements/?$ /8.7/docs/reference/announcements-release-notes/overview/ [R=301,L]
RewriteRule ^docs/guides/migrating-from-camunda-7/technical-details/?$ /8.7/docs/guides/migrating-from-camunda-7/migration-journey/ [R=301,L]
RewriteRule ^docs/self-managed/document-handling/(.*)$ /8.7/docs/self-managed/concepts/document-handling/$1 [R=301,L]
RewriteRule ^docs/components/concepts/what-is-camunda-8/(.*)$ /8.7/docs/components/ [R=301,L]
RewriteRule ^docs/components/concepts/document-handling/(.*)$ /8.7/docs/components/document-handling/getting-started/ [R=301,L]
RewriteRule ^docs/guides/document-handling/(.*)$ /8.7/docs/components/document-handling/getting-started/ [R=301,L]
RewriteRule ^docs/self-managed/concepts/document-handling/document-storage-configuration/(.*)$ /8.7/docs/self-managed/document-handling/configuration/overview/ [R=301,L]
RewriteRule ^docs/components/document-handling/use-cases/use-cases/(.*)$ /8.7/docs/components/document-handling/use-cases/ [R=301,L]
RewriteRule ^docs/components/document-handling/use-cases/display-and-download-document/(.*)$ /8.7/docs/components/document-handling/display-and-download-document/ [R=301,L]
RewriteRule ^docs/components/document-handling/use-cases/send-document-to-external-system-via-connector/(.*)$ /8.7/docs/components/document-handling/send-document-to-external-system-via-connector/ [R=301,L]
RewriteRule ^docs/components/document-handling/use-cases/upload-document-to-bpmn-process/(.*)$ /8.7/docs/components/document-handling/upload-document-to-bpmn-process/ [R=301,L]
RewriteRule ^docs/self-managed/operational-guides/update-guide/820-to-830/(.*)$ https://unsupported.docs.camunda.io/8.3/docs/self-managed/operational-guides/update-guide/820-to-830/ [R=301,L]
RewriteRule ^docs/self-managed/setup/guides/prefix-elasticsearch-opensearch-indices/(.*)$ /8.7/docs/self-managed/setup/guides/prefix-elasticsearch-indices/ [R=301,L]
RewriteRule ^docs/self-managed/operational-guides/troubleshooting/log-levels/?$ /8.7/docs/self-managed/operational-guides/monitoring/log-levels/ [R=301,L]
