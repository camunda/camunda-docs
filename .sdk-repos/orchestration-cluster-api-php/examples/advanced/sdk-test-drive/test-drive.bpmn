<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="php-sdk-test-drive-definitions"
                  targetNamespace="https://camunda.com/examples/php-sdk">
  <bpmn:process id="__PROCESS_ID__" name="PHP SDK test drive" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>to-greet</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="to-greet" sourceRef="start" targetRef="greet" />
    <bpmn:serviceTask id="greet" name="Create greeting">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="__JOB_TYPE__" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>to-greet</bpmn:incoming>
      <bpmn:outgoing>to-end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="to-end" sourceRef="greet" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>to-end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="php-sdk-test-drive-diagram">
    <bpmndi:BPMNPlane id="php-sdk-test-drive-plane" bpmnElement="__PROCESS_ID__">
      <bpmndi:BPMNShape id="start-di" bpmnElement="start">
        <dc:Bounds x="180" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="greet-di" bpmnElement="greet">
        <dc:Bounds x="270" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-di" bpmnElement="end">
        <dc:Bounds x="430" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to-greet-di" bpmnElement="to-greet">
        <di:waypoint x="216" y="120" />
        <di:waypoint x="270" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-end-di" bpmnElement="to-end">
        <di:waypoint x="370" y="120" />
        <di:waypoint x="430" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
